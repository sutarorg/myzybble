# =============================================================================
# zybble — environment variables
# =============================================================================
#
# Copy to `.env.local` for local development. Never commit a file with real
# values; `.gitignore` excludes `.env*` except this template.
#
# Where each value goes in production:
#   Vercel   → Project Settings → Environment Variables
#              (set separate values for Development / Preview / Production)
#   Railway  → Service → Variables (scraper worker)
#   Supabase → Project Settings → API (URL + keys), Database (connection string)
#
# The `service_role` key, Razorpay key secret and webhook secret, Gemini key,
# Resend key, database password and SMTP passwords are SERVER-ONLY. None of them
# is prefixed NEXT_PUBLIC_ and none may ever be imported into a Client
# Component — `src/lib/env.ts` is marked `server-only` to enforce that.
# =============================================================================


# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------

# Public site origin. Used for auth redirects, email links and canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Enables clearly-labelled fixture data instead of real scraping.
# Only takes effect when NODE_ENV=development. Fixture leads are written with
# `is_dev_data = true` and are excluded from production surfaces.
NEXT_PUBLIC_DEV_MODE=false

# Shared secret for Vercel Cron. Vercel sends
# `Authorization: Bearer $CRON_SECRET` to /api/cron/*; without it the
# scheduled routes refuse to run. Generate with `openssl rand -hex 32`.
CRON_SECRET=


# -----------------------------------------------------------------------------
# Supabase — auth, Postgres, RLS, Realtime
# -----------------------------------------------------------------------------

# Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Project Settings → API → `anon` key. Safe to expose: RLS is the boundary.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings → API → `service_role` key.
# SERVER ONLY. Bypasses RLS — every function that uses it performs its own
# explicit authorisation check first.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string, used only by `npm run db:migrate`.
# Project Settings → Database → Connection string → URI.
# Contains the database password: never expose it to the browser.
SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres


# -----------------------------------------------------------------------------
# Razorpay — USD subscriptions
# -----------------------------------------------------------------------------
# Note: international (non-INR) payments must be enabled on your Razorpay
# account before USD subscriptions will work. See docs/billing.md.

# Dashboard → Settings → API Keys → Key Id. Public; used by the checkout widget.
RAZORPAY_KEY_ID=

# Dashboard → Settings → API Keys → Key Secret. SERVER ONLY.
# Used to verify the payment signature returned by Checkout.
RAZORPAY_KEY_SECRET=

# Dashboard → Settings → Webhooks → Secret. SERVER ONLY.
# Used to verify the HMAC-SHA256 signature on every inbound webhook.
# This is a DIFFERENT secret from the API key secret.
RAZORPAY_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# Resend — transactional + campaign email
# -----------------------------------------------------------------------------

# resend.com → API Keys. SERVER ONLY.
RESEND_API_KEY=

# From address for all outgoing mail. The domain must be verified in Resend —
# the default `onboarding@resend.dev` only delivers to your own account.
EMAIL_FROM=zybble <hello@yourdomain.com>

# Optional reply-to. Defaults to EMAIL_FROM when unset.
EMAIL_REPLY_TO=

# Comma-separated list of domains verified with your email provider. A mailbox
# can only be marked `verified` once its domain appears here.
RESEND_VERIFIED_DOMAINS=yourdomain.com

# Webhook signing secret for delivery events (bounces, complaints, replies).
# resend.com → Webhooks. SERVER ONLY.
RESEND_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# Google Gemini — AI Assistant
# -----------------------------------------------------------------------------

# aistudio.google.com/apikey. SERVER ONLY — the browser never sees this and
# never calls Gemini directly; all traffic goes through /api/ai/*.
GEMINI_API_KEY=

# Optional model override. Defaults to the current production model
# `gemini-3.8-flash`, with an automatic fallback chain. See docs/ai.md.
GEMINI_MODEL=gemini-3.8-flash


# -----------------------------------------------------------------------------
# Mailbox credential encryption
# -----------------------------------------------------------------------------

# AES-256-GCM key for SMTP mailbox passwords at rest. Must be at least 32
# characters. Generate with `openssl rand -base64 32`.
# Rotating this requires re-wrapping stored credentials — see docs/security.md.
MAILBOX_ENCRYPTION_KEY=


# -----------------------------------------------------------------------------
# Scraper worker (Railway)
# -----------------------------------------------------------------------------
# `scraper/src/config.ts` reads the WORKER_*/SCRAPER_* values below on the
# Railway service. The web app only needs WORKER_BASE_URL +
# WORKER_SHARED_SECRET to surface worker status in /settings/integrations.

# Shared secret for the web app to read the worker's /health endpoint. Both
# sides must hold the same value. Generate with `openssl rand -hex 32`.
WORKER_SHARED_SECRET=

# Public base URL of the worker, used for status pages and health pings.
WORKER_BASE_URL=https://your-worker.up.railway.app

# Stable identifier for this worker instance. Defaults to RAILWAY_REPLICA_ID,
# then the hostname (see scraper/src/config.ts).
WORKER_ID=

# Where the pinned scraper binary lives inside the image. This is the binary
# the worker spawns directly (config.scraperBin).
SCRAPER_BIN=/usr/local/bin/google-maps-scraper

# Playwright browsers, pre-installed at image build time.
PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright

# Engine concurrency and per-job limits (single job).
SCRAPER_CONCURRENCY=2
SCRAPER_PAGES_PER_BROWSER=2
SCRAPER_DEPTH=1
SCRAPER_INACTIVITY=3m
# Optional comma-separated proxy list passed as `-proxies`.
SCRAPER_PROXIES=

# Queue polling / leases (milliseconds unless suffixed).
WORKER_POLL_INTERVAL_MS=3000
WORKER_HEARTBEAT_INTERVAL_MS=20000
WORKER_LEASE_SECONDS=120
WORKER_RECOVERY_INTERVAL_MS=60000
# Hard wall-clock ceiling for one job, so a wedged browser can't hold a lease.
WORKER_MAX_JOB_RUNTIME_MS=2700000
# Grace period after SIGTERM before force-exit (Railway draining).
WORKER_DRAIN_TIMEOUT_MS=30000

# Directory for transient input/result files.
WORKER_WORKDIR=/tmp/zybble-scraper

# Health server port (Railway healthcheck hits /health on this).
PORT=8080

# Use deterministic fixtures instead of the real engine. Railway: leave false.
WORKER_DEV_MODE=false
