# =============================================================================
# zybble scraping worker — Railway service image
#
# What runs here: `scraper/src/index.ts` — a long-lived process that polls the
# `scrape_jobs` queue in Supabase, claims one job at a time behind a lease,
# drives the pinned upstream engine, and streams results back. It never accepts
# inbound scraping requests; the database is the only interface.
#
# The engine is `gosom/google-maps-scraper` pinned to v1.18.1 (commit
# 549e4b5e61c7103685ef8392f246ebdba783ed03) — see scraper/PIN.md for why the
# pin exists and how to move it.
#
# Build (locally):
#   docker build -f Dockerfile.worker -t zybble-worker .
#   docker run --rm -p 8080:8080 \
#     -e NEXT_PUBLIC_SUPABASE_URL=... -e SUPABASE_SERVICE_ROLE_KEY=... \
#     zybble-worker
# =============================================================================

# ---------------------------------------------------------------------------
# Stage 1 — the pinned engine + its Playwright browsers.
#
# Built from source at the pinned tag rather than copied out of the upstream
# image, so the binary and browser set are exactly what we verified (PIN.md).
# PLAYWRIGHT_BROWSERS_PATH is set *before* the browser install so the browsers
# land in a directory we can copy into the runtime stage wholesale.
# ---------------------------------------------------------------------------
FROM golang:1.26.6-bookworm AS engine

ARG ENGINE_VERSION=v1.18.1
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright

# The engine binary. `go install` puts it on /go/bin with the module's own
# name, which is what scraper/src/config.ts expects on PATH.
RUN go install github.com/gosom/google-maps-scraper@${ENGINE_VERSION}

# The Chromium bundle the engine's Playwright driver expects, plus the OS
# packages it needs. Installed with playwright-go's own CLI so the browser
# revisions always match what the engine links against.
RUN go run github.com/playwright-community/playwright-go/cmd/playwright@latest install --with-deps chromium

# ---------------------------------------------------------------------------
# Stage 2 — runtime: Node 22 + engine + browsers + worker sources.
# ---------------------------------------------------------------------------
FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production \
    SCRAPER_BIN=/usr/local/bin/google-maps-scraper \
    PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright \
    WORKER_WORKDIR=/tmp/zybble-scraper \
    PORT=8080

# Chromium shared libraries for the runtime stage (the build stage's
# --with-deps packages don't carry over between stages).
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        libasound2 \
        libatk-bridge2.0-0 \
        libatk1.0-0 \
        libatspi2.0-0 \
        libcairo2 \
        libcups2 \
        libdbus-1-3 \
        libdrm2 \
        libgbm1 \
        libnspr4 \
        libnss3 \
        libpango-1.0-0 \
        libx11-6 \
        libxcb1 \
        libxcomposite1 \
        libxdamage1 \
        libxext6 \
        libxfixes3 \
        libxkbcommon0 \
        libxrandr2 \
    && rm -rf /var/lib/apt/lists/*

# Engine binary + browsers from stage 1.
COPY --from=engine /go/bin/google-maps-scraper /usr/local/bin/google-maps-scraper
COPY --from=engine /opt/ms-playwright /opt/ms-playwright

# Worker sources. The scraper imports shared modules from src/lib and
# src/types, so the whole repo source is copied (node_modules etc. are kept
# out by .dockerignore).
WORKDIR /app

# Guardrail. Railway builds with the service's **Root Directory** as the build
# context, so pointing it at `/scraper` produces a context that holds neither
# `package.json` nor `src/` and the COPY instructions below fail with the
# famously unhelpful `failed to compute cache key: "/scraper": not found`.
# Fail here instead, with the setting that needs changing.
RUN for path in package.json package-lock.json scraper/src/index.ts src/lib/logger.ts tsconfig.json; do \
      test -e "$path" || { \
        echo "ERROR: build context is missing '$path'."; \
        echo "Railway → this service → Settings → Root Directory must be the repository root (empty or /), NOT /scraper."; \
        echo "Dockerfile Path stays /Dockerfile.worker. See docs/deployment.md §3."; \
        exit 1; \
      }; \
    done

COPY package.json package-lock.json ./
COPY scraper ./scraper
COPY src ./src
COPY tsconfig.json ./

# Full install (not --omit=dev): the worker runs through tsx, a devDependency.
RUN npm ci

# Sanity gate: the build fails loudly if the engine didn't come through.
RUN google-maps-scraper -h > /dev/null

RUN mkdir -p /tmp/zybble-scraper && chown -R node:node /app /tmp/zybble-scraper
USER node

EXPOSE 8080

# Railway hits /health (see railway.toml); the endpoint reports queue
# connectivity and engine readiness, not just process liveness.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||8080)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["npx", "tsx", "scraper/src/index.ts"]
